views:
  - type: table
    name: Table
    filters:
      and:
        - file.hasTag("excalidraw")
    order:
      - file.name
      - aliases
      - tags
      - file.size
    sort:
      - property: tags
        direction: DESC
      - property: file.size
        direction: DESC
      - property: aliases
        direction: ASC
      - property: file.backlinks
        direction: DESC
      - property: file.tags
        direction: ASC
      - property: formula.Untitled
        direction: DESC
      - property: file.name
        direction: ASC
    columnSize:
      file.name: 352
      note.aliases: 127
